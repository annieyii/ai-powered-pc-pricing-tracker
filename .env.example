# OpenAI-compatible endpoint for the offline extraction step (tracker/extract.py).
# Not used by the dashboard. The app runs with none of these set.
#
# Works against any OpenAI-compatible chat-completions server:
#   remote endpoint   LLM_BASE_URL=https://<host>/v1
#   local Ollama      LLM_BASE_URL=http://localhost:11434/v1
#
# All three are required. extract.py refuses to guess.

LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
