# OpenAI-compatible endpoint for the two by-hand steps: the offline extraction
# (tracker/extract.py) and the observation summary (tracker/summarise.py).
#
# Nothing is called on page load. With none of these set the dashboard still
# renders; its regenerate button is disabled and names the missing variable.
#
# Works against any OpenAI-compatible chat-completions server:
#   remote endpoint   LLM_BASE_URL=https://<host>/v1
#   local Ollama      LLM_BASE_URL=http://localhost:11434/v1
#
# All three are required. Neither entry point guesses at a default.

LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
