# OpenAI-compatible endpoint for the two by-hand steps: the offline extraction
# (tracker/extract.py) and the observation summary (tracker/summarise.py).
#
# Nothing is called on page load. With none of these set the dashboard still
# renders; its regenerate button is disabled and names the missing variable.
#
# Works against any OpenAI-compatible chat-completions server. Only these three
# values change; no code does. A hosted endpoint and a local one look the same
# from here; neither is special-cased:
#   hosted  LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
#   local   LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=<a pulled model>
# The score in the report is from the first of these.
#
# All three are required. Neither entry point guesses at a default.

LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Best Buy Products API (tracker/bestbuy.py) --------------------------
#
# Not required to run anything in this repository. Every price on record was
# captured by hand; this adapter is the seam that would replace that, and it
# has never been run against the live API because no key was available.
#
# Request a key at https://developer.bestbuy.com. The key travels as the
# `apiKey` query parameter. There is no token exchange and no connection id:
# the SKU is the only identifier, and it is the same SKU the CSVs key on.
#
# A store-fixed capture also needs the store-availability call
# (/products/<sku>/stores.json). `product_url` can build that URL, but no entry
# point calls it yet, so there is no store id variable here: a variable nothing
# reads is a promise the code does not keep.

BESTBUY_API_KEY=
